static_resources:
  listeners:
  - name: listener_http
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 4321
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: ingress_http
          codec_type: AUTO
          stream_idle_timeout: 0s
          http_protocol_options:
            allow_absolute_url: true
          http2_protocol_options: {}
          route_config:
            name: local_route
            virtual_hosts:
            - name: app
              domains: ["*"]
              routes:
              - match:
                  prefix: "/"
                  headers:
                  - name: ":authority"
                    string_match:
                      exact: "localhost:4321"
                route:
                  cluster: delayed_service
                  timeout: 15s
                  retry_policy:
                    retry_on: ""
                    num_retries: 0
                  internal_redirect_policy:
                    max_internal_redirects: 3
                    allow_cross_scheme_redirect: true
              # Route HTTPS requests to the TLS-enabled forward proxy cluster
              - match:
                  prefix: "/"
                  headers:
                  - name: ":scheme"
                    string_match:
                      exact: "https"
                route:
                  cluster: dynamic_forward_proxy_tls
                  timeout: 15s
                  retry_policy:
                    retry_on: ""
                    num_retries: 0
                  internal_redirect_policy:
                    max_internal_redirects: 3
                    allow_cross_scheme_redirect: true
              # Route HTTP requests to the plaintext forward proxy cluster
              - match:
                  prefix: "/"
                route:
                  cluster: dynamic_forward_proxy_plaintext
                  timeout: 15s
                  retry_policy:
                    retry_on: ""
                    num_retries: 0
                  internal_redirect_policy:
                    max_internal_redirects: 3
                    allow_cross_scheme_redirect: true
          http_filters:
          - name: envoy.filters.http.lua
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
              default_source_code:
                inline_string: |
                  local MIN_TIMEOUT_MS = 1
                  local MAX_TIMEOUT_MS = 60000
                  local function bad_request(handle, msg)
                    handle:respond(
                      { [":status"] = "400", ["content-type"] = "text/plain" },
                      msg
                    )
                  end
                  function envoy_on_request(handle)
                    local h = handle:headers()
                    local timeout_ms = h:get("x-timeout-ms")
                    if timeout_ms == nil then
                      return
                    end
                    if not string.match(timeout_ms, "^%d+$") then
                      bad_request(handle, "x-timeout-ms must be an integer number of milliseconds\n")
                      return
                    end
                    local n = tonumber(timeout_ms)
                    if n == nil then
                      bad_request(handle, "x-timeout-ms is invalid\n")
                      return
                    end
                    if n < MIN_TIMEOUT_MS or n > MAX_TIMEOUT_MS then
                      bad_request(handle, "x-timeout_ms out of allowed range (1..60000)\n")
                      return
                    end
                    h:replace("x-envoy-upstream-rq-timeout-ms", tostring(n))
                    h:remove("x-envoy-upstream-rq-per-try-timeout-ms")
                  end
          - name: envoy.filters.http.local_ratelimit
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
              stat_prefix: global_qps_limiter
              token_bucket:
                max_tokens: __GLOBAL_QPS_BURST__
                tokens_per_fill: __GLOBAL_QPS_LIMIT__
                fill_interval: 1s
              filter_enabled:
                runtime_key: global_qps_limit_enabled
                default_value:
                  numerator: 100
                  denominator: HUNDRED
              filter_enforced:
                runtime_key: global_qps_limit_enforced
                default_value:
                  numerator: 100
                  denominator: HUNDRED
              status:
                code: 429
              local_rate_limit_per_downstream_connection: false
              enable_x_ratelimit_headers: DRAFT_VERSION_03
          - name: envoy.filters.http.dynamic_forward_proxy
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.dynamic_forward_proxy.v3.FilterConfig
              dns_cache_config:
                name: dynamic_forward_proxy_cache
                dns_lookup_family: V4_PREFERRED
                typed_dns_resolver_config:
                  name: envoy.network.dns_resolver.cares
                  typed_config:
                    "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
  - name: delayed_service
    type: STRICT_DNS
    connect_timeout: 2s
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: delayed_service
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: delayed_service
                port_value: 3000
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
    transport_socket:
      name: envoy.transport_sockets.raw_buffer
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.raw_buffer.v3.RawBuffer

  # Cluster for HTTPS upstream targets — always uses TLS
  - name: dynamic_forward_proxy_tls
    lb_policy: CLUSTER_PROVIDED
    connect_timeout: 5s
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        use_downstream_protocol_config:
          http_protocol_options: {}
          http2_protocol_options: {}
        upstream_http_protocol_options:
          auto_sni: true
          auto_san_validation: true
    cluster_type:
      name: envoy.clusters.dynamic_forward_proxy
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
        dns_cache_config:
          name: dynamic_forward_proxy_cache
          dns_lookup_family: V4_PREFERRED
          typed_dns_resolver_config:
            name: envoy.network.dns_resolver.cares
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        common_tls_context:
          validation_context:
            trusted_ca:
              filename: /etc/ssl/certs/ca-certificates.crt

  # Cluster for plain HTTP upstream targets — never uses TLS
  - name: dynamic_forward_proxy_plaintext
    lb_policy: CLUSTER_PROVIDED
    connect_timeout: 5s
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        use_downstream_protocol_config:
          http_protocol_options: {}
          http2_protocol_options: {}
    cluster_type:
      name: envoy.clusters.dynamic_forward_proxy
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
        dns_cache_config:
          name: dynamic_forward_proxy_cache
          dns_lookup_family: V4_PREFERRED
          typed_dns_resolver_config:
            name: envoy.network.dns_resolver.cares
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
        allow_insecure_cluster_options: true
    transport_socket:
      name: envoy.transport_sockets.raw_buffer
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.raw_buffer.v3.RawBuffer

admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 9901
