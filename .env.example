# Copy to .env and adjust as needed.

# Sustained global QPS allowed through Envoy (token bucket refill per second).
GLOBAL_QPS_LIMIT=10

# Optional burst capacity (max in-flight tokens). Defaults to GLOBAL_QPS_LIMIT when unset.
GLOBAL_QPS_BURST=10

# Upstream selected when the client sends an exchange header.
EXCHANGE_UPSTREAM_HOST=exchange.staging.adtonos.com
EXCHANGE_UPSTREAM_PORT=443
