# Sustained global QPS allowed through Envoy (token bucket refill per second).
GLOBAL_QPS_LIMIT=10

# Optional burst capacity (max in-flight tokens). Defaults to GLOBAL_QPS_LIMIT.
GLOBAL_QPS_BURST=10

# Upstream for requests that include an exchange header.
EXCHANGE_UPSTREAM_HOST=exchange.staging.adtonos.com
EXCHANGE_UPSTREAM_PORT=443
